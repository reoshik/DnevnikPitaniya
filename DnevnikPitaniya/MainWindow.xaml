<Window x:Class="DnevnikPitaniya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дневник питания"
        Height="800"
        Width="1200"
        MinHeight="700"
        MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F6F0FF"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="Purple" Color="#8952C7"/>
        <SolidColorBrush x:Key="DarkPurple" Color="#492477"/>
        <SolidColorBrush x:Key="LightPurple" Color="#E9D9FF"/>

        <!-- Стиль кнопок меню -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Background" Value="#F1E7FF"/>
            <Setter Property="Foreground" Value="#492477"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- Стиль карточек -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#E7D6FF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль обычного текста -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#38215B"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Стиль основной кнопки -->
        <Style x:Key="PurpleButton" TargetType="Button">
            <Setter Property="Background" Value="#8952C7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Иконки приёмов пищи -->
        <Style x:Key="MealImage" TargetType="Image">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Source" Value="/Images/food.png"/>

            <Style.Triggers>
                <DataTrigger Binding="{Binding Meal}" Value="Завтрак">
                    <Setter Property="Source"
                            Value="/Images/breakfast.png"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Meal}" Value="Обед">
                    <Setter Property="Source"
                            Value="/Images/lunch.png"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Meal}" Value="Ужин">
                    <Setter Property="Source"
                            Value="/Images/dinner.png"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Meal}" Value="Перекус">
                    <Setter Property="Source"
                            Value="/Images/apple.png"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="165"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- БОКОВОЕ МЕНЮ -->
        <Border Grid.Column="0"
                Background="#E7D3FF"
                BorderBrush="#D7BFFF"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <StackPanel Margin="12,20,12,10">

                    <Image Source="/Images/logo.png"
                           Width="75"
                           Height="75"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                    <TextBlock Text="Дневник питания"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#492477"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>

                </StackPanel>

                <!-- Кнопки меню -->
                <StackPanel Grid.Row="1"
                            Margin="10,22,10,0">

                    <Button Style="{StaticResource MenuButton}"
                            Background="#8952C7"
                            Foreground="White"
                            Click="Diary_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂"
                                       FontSize="22"
                                       Margin="0,0,9,0"/>
                            <TextBlock Text="Дневник"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Click="Products_Click">

                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/apple.png"
                                   Width="25"
                                   Height="25"
                                   Margin="0,0,9,0"/>
                            <TextBlock Text="Продукты"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Click="Weight_Click">

                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/weight.png"
                                   Width="25"
                                   Height="25"
                                   Margin="0,0,9,0"/>
                            <TextBlock Text="История веса"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Click="Statistics_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▥"
                                       FontSize="21"
                                       Margin="0,0,9,0"/>
                            <TextBlock Text="Статистика"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Click="Profile_Click">

                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/profile.png"
                                   Width="25"
                                   Height="25"
                                   Margin="0,0,9,0"/>
                            <TextBlock Text="Профиль"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MenuButton}"
                            Click="About_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ⓘ"
                                       FontSize="20"
                                       Margin="0,0,9,0"/>
                            <TextBlock Text="О программе"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>

                <!-- Нижняя иллюстрация -->
                <Image Grid.Row="2"
                       Source="/Images/apple.png"
                       Width="85"
                       Height="85"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            </Grid>
        </Border>

        <!-- ОСНОВНАЯ ЧАСТЬ -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="12,12,15,8">

                    <!-- ШАПКА -->
                    <Grid Margin="5,5,5,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">

                            <Image Source="/Images/logo.png"
                                   Width="65"
                                   Height="65"
                                   Stretch="Uniform"
                                   Margin="0,0,12,0"/>

                            <StackPanel VerticalAlignment="Center">

                                <TextBlock Text="Дневник питания"
                                           FontSize="31"
                                           FontWeight="Bold"
                                           Foreground="#492477"/>

                                <TextBlock Text="Следи за питанием. Достигай целей!"
                                           FontSize="14"
                                           Foreground="#8150BD"/>

                            </StackPanel>
                        </StackPanel>

                        <!-- Профиль -->
                        <Border Grid.Column="1"
                                Background="#F1E7FF"
                                BorderBrush="#DCC7FF"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/Images/profile.png"
                                       Width="42"
                                       Height="42"
                                       Stretch="Uniform"
                                       Margin="0,0,10,0"/>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Яна"
                                               FontWeight="Bold"
                                               FontSize="15"/>

                                    <TextBlock Text="Цель: контроль питания"
                                               FontSize="12"/>

                                </StackPanel>

                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- КАРТОЧКИ КАЛОРИЙ -->
                    <UniformGrid Columns="3"
                                 Margin="0,0,0,5">

                        <!-- Съедено -->
                        <Border Style="{StaticResource Card}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/Images/food.png"
                                       Width="48"
                                       Height="48"
                                       Stretch="Uniform"
                                       Margin="0,0,12,0"/>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Съедено сегодня"
                                               FontSize="13"/>

                                    <TextBlock x:Name="EatenText"
                                               Text="0 ккал"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#592A92"/>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Норма -->
                        <Border Style="{StaticResource Card}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/Images/apple.png"
                                       Width="48"
                                       Height="48"
                                       Stretch="Uniform"
                                       Margin="0,0,12,0"/>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Норма калорий"
                                               FontSize="13"/>

                                    <TextBlock Text="1900 ккал"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#592A92"/>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Осталось -->
                        <Border Style="{StaticResource Card}">

                            <StackPanel Orientation="Horizontal">

                                <Image Source="/Images/weight.png"
                                       Width="48"
                                       Height="48"
                                       Stretch="Uniform"
                                       Margin="0,0,12,0"/>

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock Text="Осталось"
                                               FontSize="13"/>

                                    <TextBlock x:Name="RemainingText"
                                               Text="1900 ккал"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="#592A92"/>

                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- БЛОК КБЖУ -->
                    <Border Style="{StaticResource Card}">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="КБЖУ"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#492477"
                                           Margin="0,0,0,12"/>

                                <TextBlock x:Name="ProteinText"
                                           Text="Белки: 0 / 100 г"
                                           FontSize="14"/>

                                <ProgressBar x:Name="ProteinBar"
                                             Maximum="100"
                                             Height="12"
                                             Foreground="#A875E5"
                                             Background="#E9D9FF"
                                             Margin="0,5,0,10"/>

                                <TextBlock x:Name="FatText"
                                           Text="Жиры: 0 / 70 г"
                                           FontSize="14"/>

                                <ProgressBar x:Name="FatBar"
                                             Maximum="70"
                                             Height="12"
                                             Foreground="#B98CEB"
                                             Background="#E9D9FF"
                                             Margin="0,5,0,10"/>

                                <TextBlock x:Name="CarbsText"
                                           Text="Углеводы: 0 / 200 г"
                                           FontSize="14"/>

                                <ProgressBar x:Name="CarbsBar"
                                             Maximum="200"
                                             Height="12"
                                             Foreground="#9560D0"
                                             Background="#E9D9FF"
                                             Margin="0,5,0,0"/>

                            </StackPanel>

                            <!-- Иллюстрация еды -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">

                                <Image Source="/Images/food.png"
                                       Width="115"
                                       Height="115"
                                       Stretch="Uniform"/>

                                <TextBlock Text="Питайся с пользой!"
                                           FontWeight="Bold"
                                           Foreground="#8150BD"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>

                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- НИЖНИЕ БЛОКИ -->
                    <Grid Margin="0,3,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="0.85*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ПРИЁМЫ ПИЩИ -->
                        <Border Grid.Column="0"
                                Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Приёмы пищи"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#492477"
                                           Margin="0,0,0,10"/>

                                <ListBox x:Name="DiaryList"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         MinHeight="190">

                                    <ListBox.ItemTemplate>

                                        <DataTemplate>

                                            <Border BorderBrush="#E9D9FF"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="7">

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Image Style="{StaticResource MealImage}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,10,0"/>

                                                    <StackPanel Grid.Column="1">

                                                        <TextBlock Text="{Binding Meal}"
                                                                   FontWeight="Bold"
                                                                   Foreground="#492477"/>

                                                        <TextBlock Text="{Binding Product}"
                                                                   FontSize="12"/>

                                                        <TextBlock Text="{Binding Details}"
                                                                   FontSize="11"
                                                                   Foreground="#8150BD"/>

                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CaloriesText}"
                                                               FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Foreground="#592A92"/>

                                                </Grid>
                                            </Border>

                                        </DataTemplate>

                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </StackPanel>
                        </Border>

                        <!-- ДОБАВЛЕНИЕ ПРОДУКТА -->
                        <Border Grid.Column="1"
                                Style="{StaticResource Card}">

                            <StackPanel>

                                <TextBlock Text="Добавить продукт"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#492477"
                                           Margin="0,0,0,15"/>

                                <Image Source="/Images/apple.png"
                                       Width="65"
                                       Height="65"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                                <TextBlock Text="Продукт:"
                                           FontSize="13"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="ProductCombo"
                                          Height="36"
                                          FontSize="13"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,0,13"/>

                                <TextBlock Text="Приём пищи:"
                                           FontSize="13"
                                           Margin="0,0,0,5"/>

                                <ComboBox x:Name="MealCombo"
                                          Height="36"
                                          FontSize="13"
                                          SelectedIndex="0"
                                          Margin="0,0,0,13">

                                    <ComboBoxItem Content="Завтрак"/>
                                    <ComboBoxItem Content="Обед"/>
                                    <ComboBoxItem Content="Ужин"/>
                                    <ComboBoxItem Content="Перекус"/>

                                </ComboBox>

                                <TextBlock Text="Масса (г):"
                                           FontSize="13"
                                           Margin="0,0,0,5"/>

                                <TextBox x:Name="MassTextBox"
                                         Height="36"
                                         FontSize="14"
                                         Padding="8"
                                         Margin="0,0,0,14"/>

                                <Button Content="＋  Добавить"
                                        Style="{StaticResource PurpleButton}"
                                        Click="AddProduct_Click"
                                        Width="180"
                                        HorizontalAlignment="Center"/>

                                <TextBlock x:Name="MessageText"
                                           Foreground="#8150BD"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="3,10,3,0"/>

                            </StackPanel>
                        </Border>

                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- НИЖНЯЯ ПАНЕЛЬ -->
            <Border Grid.Row="1"
                    Background="#E4D0FF"
                    Padding="10,5">

                <DockPanel>

                    <TextBlock Text="Сегодня"
                               VerticalAlignment="Center"
                               Foreground="#492477"/>

                    <TextBlock Text="Хорошего дня!"
                               DockPanel.Dock="Right"
                               VerticalAlignment="Center"
                               Foreground="#492477"/>

                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
