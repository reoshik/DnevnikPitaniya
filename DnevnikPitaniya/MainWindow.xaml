<Window x:Class="DnevnikPitaniya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дневник питания"
        Width="1280" Height="800"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7F6"
        Foreground="#25352E"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>

        <SolidColorBrush x:Key="Accent" Color="#32765B"/>
        <SolidColorBrush x:Key="Muted" Color="#78857D"/>
        <SolidColorBrush x:Key="Line" Color="#E6ECE8"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#25352E"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,18"/>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface"
                                        Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface"
                                        Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#67776D"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="BorderBrush" Value="#DCE4DE"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#DCE4DE"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="7"/>
            <Setter Property="Background" Value="#EDF1EE"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,9,0,21"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая навигация -->
        <Border Background="White"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,28,18,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="12,0,0,34">
                    <Border Background="#E9F3ED"
                            CornerRadius="12"
                            Width="44" Height="44"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Дневник"
                               FontSize="23"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="питания"
                               FontSize="23"
                               Foreground="{StaticResource Accent}"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Content="Дневник"
                            Style="{StaticResource NavigationButton}"
                            Background="#E9F3ED"
                            Foreground="#32765B"
                            FontWeight="SemiBold"
                            Click="Diary_Click"/>

                    <Button Content="Продукты"
                            Style="{StaticResource NavigationButton}"
                            Click="Products_Click"/>

                    <Button Content="История веса"
                            Style="{StaticResource NavigationButton}"
                            Click="Weight_Click"/>

                    <Button Content="Статистика"
                            Style="{StaticResource NavigationButton}"
                            Click="Statistics_Click"/>

                    <Button Content="Профиль"
                            Style="{StaticResource NavigationButton}"
                            Click="Profile_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="О программе"
                            Style="{StaticResource NavigationButton}"
                            Click="About_Click"/>
                    <Border BorderBrush="{StaticResource Line}"
                            BorderThickness="0,1,0,0"
                            Padding="12,16,0,0">
                        <TextBlock Text="Локальное приложение"
                                   FontSize="12"
                                   Foreground="{StaticResource Muted}"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Рабочая область -->
        <Grid Grid.Column="1" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Мой дневник"
                               FontSize="29"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Питание под контролем — день за днём"
                               Foreground="{StaticResource Muted}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="15,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#E9F3ED"
                                CornerRadius="18"
                                Width="36" Height="36"
                                Margin="0,0,12,0">
                            <TextBlock Text="Я"
                                       Foreground="{StaticResource Accent}"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Яна" FontWeight="SemiBold"/>
                            <TextBlock Text="Контроль питания"
                                       FontSize="12"
                                       Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Дневник и форма -->
                    <StackPanel>

                        <Border Style="{StaticResource Panel}"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Приёмы пищи"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>
                                    <Border Grid.Column="1"
                                            Background="#F1F5F2"
                                            CornerRadius="6"
                                            Padding="10,4">
                                        <TextBlock Text="Сегодня"
                                                   FontSize="12"
                                                   Foreground="#62766A"/>
                                    </Border>
                                </Grid>

                                <ListBox x:Name="DiaryList"
                                         MinHeight="220"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBox">
                                                                <Border Background="#F7F9F7"
                                                                        CornerRadius="10"
                                                                        Padding="24,35">
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="Начните с первого приёма пищи"
                                                                                   FontWeight="SemiBold"
                                                                                   TextAlignment="Center"/>
                                                                        <TextBlock Text="Выберите продукт и укажите массу в форме ниже."
                                                                                   Foreground="#78857D"
                                                                                   TextAlignment="Center"
                                                                                   Margin="0,9,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,14"
                                                    BorderBrush="#E6ECE8"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Meal}"
                                                                   Foreground="#32765B"
                                                                   FontSize="12"
                                                                   Margin="0,0,0,5"/>
                                                        <TextBlock Text="{Binding Product}"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Details}"
                                                                   FontSize="12"
                                                                   Foreground="#78857D"
                                                                   Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding CaloriesText}"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Добавить продукт"
                                           Style="{StaticResource Heading}"/>

                                <TextBlock Text="Продукт"
                                           Style="{StaticResource Caption}"/>
                                <ComboBox x:Name="ProductCombo"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Приём пищи"
                                                   Style="{StaticResource Caption}"/>
                                        <ComboBox x:Name="MealCombo"
                                                  SelectedIndex="0">
                                            <ComboBoxItem Content="Завтрак"/>
                                            <ComboBoxItem Content="Обед"/>
                                            <ComboBoxItem Content="Ужин"/>
                                            <ComboBoxItem Content="Перекус"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Масса, г"
                                                   Style="{StaticResource Caption}"/>
                                        <TextBox x:Name="MassTextBox"/>
                                    </StackPanel>
                                </Grid>

                                <Button Content="+  Добавить в дневник"
                                        Style="{StaticResource ActionButton}"
                                        HorizontalContentAlignment="Center"
                                        Click="AddProduct_Click"/>

                                <TextBlock x:Name="MessageText"
                                           Foreground="#32765B"
                                           FontSize="12"
                                           Margin="0,12,0,0"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Итоги дня -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Panel}"
                                Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Баланс дня"
                                           Style="{StaticResource Heading}"/>

                                <TextBlock Text="Осталось до нормы"
                                           Style="{StaticResource Caption}"/>

                                <TextBlock x:Name="RemainingText"
                                           Text="1900 ккал"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}"
                                           Margin="0,0,0,24"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Съедено"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock x:Name="EatenText"
                                               Grid.Column="1"
                                               Text="0 ккал"
                                               FontWeight="SemiBold"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Дневная норма"
                                               Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="1900 ккал"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <TextBlock Text="Макронутриенты"
                                           Style="{StaticResource Heading}"/>

                                <TextBlock x:Name="ProteinText"
                                           Text="Белки: 0 / 100 г"/>
                                <ProgressBar x:Name="ProteinBar"
                                             Maximum="100"
                                             Foreground="#5E9478"/>

                                <TextBlock x:Name="FatText"
                                           Text="Жиры: 0 / 70 г"/>
                                <ProgressBar x:Name="FatBar"
                                             Maximum="70"
                                             Foreground="#C59A59"/>

                                <TextBlock x:Name="CarbsText"
                                           Text="Углеводы: 0 / 200 г"/>
                                <ProgressBar x:Name="CarbsBar"
                                             Maximum="200"
                                             Foreground="#8299BC"
                                             Margin="0,9,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Калорийность и БЖУ порции рассчитываются автоматически по массе продукта."
                                   FontSize="12"
                                   Foreground="{StaticResource Muted}"
                                   Margin="8,18,8,0"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       Text="Дневник питания · Ваш ежедневный баланс"
                       Foreground="{StaticResource Muted}"
                       FontSize="12"
                       Margin="0,18,0,0"/>
        </Grid>
    </Grid>
</Window>