<Window x:Class="DnevnikPitaniya.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог продуктов"
        Width="1240" Height="720"
        MinWidth="1150" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F4F5F7"
        Foreground="#202720"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource ProductsWindow_TextBlock}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource ProductsWindow_TextBox}"/>
        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ProductsWindow_DataGridColumnHeader}"/>
        <Style TargetType="DataGridCell" BasedOn="{StaticResource ProductsWindow_DataGridCell}"/>
        <Style TargetType="DataGridRow" BasedOn="{StaticResource ProductsWindow_DataGridRow}"/>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Каталог продуктов"
                           FontSize="28"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Пищевая ценность указана на 100 г продукта"
                           Foreground="#727B75"
                           Margin="0,7,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+  Новый продукт"
                    Style="{StaticResource ProductsWindow_Action}"
                    VerticalAlignment="Center"
                    Click="NewProduct_Click"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Таблица -->
            <Border Background="White"
                    CornerRadius="18"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Поиск по названию"
                               Style="{StaticResource ProductsWindow_Label}"/>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             Margin="0,0,0,18"
                             TextChanged="SearchBox_TextChanged"/>

                    <DataGrid x:Name="ProductsGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EDF0EC"
                              BorderThickness="0"
                              Background="White"
                              RowHeaderWidth="0"
                              SelectionChanged="ProductsGrid_SelectionChanged">

                        <DataGrid.Columns>
<DataGridTemplateColumn Header="Фото" Width="60">
 <DataGridTemplateColumn.CellTemplate>
  <DataTemplate>
   <Grid Width="32" Height="32">
    <TextBlock Text="—" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    <Image Source="{Binding PhotoUrl}" Stretch="Uniform"/>
   </Grid>
  </DataTemplate>
 </DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="100"/>
                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding Name}"
                                                Width="*"
                                                MinWidth="160"/>
                            <DataGridTextColumn Header="Ккал"
                                                Binding="{Binding Calories, StringFormat={}{0:0.#}}"
                                                Width="75"/>
                            <DataGridTextColumn Header="Б, г"
                                                Binding="{Binding Protein, StringFormat={}{0:0.#}}"
                                                Width="65"/>
                            <DataGridTextColumn Header="Ж, г"
                                                Binding="{Binding Fat, StringFormat={}{0:0.#}}"
                                                Width="65"/>
                            <DataGridTextColumn Header="У, г"
                                                Binding="{Binding Carbs, StringFormat={}{0:0.#}}"
                                                Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="CountText"
                               Grid.Row="3"
                               Foreground="#727B75"
                               FontSize="12"
                               Margin="0,15,0,0"/>
                </Grid>
            </Border>

            <!-- Редактор -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="22">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="EditorTitle"
                                   Text="Новый продукт"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,22"/>

                        <TextBlock Text="Название"
                                   Style="{StaticResource ProductsWindow_Label}"/>
                        <TextBox x:Name="NameBox"
                                 Margin="0,0,0,16"/>
<TextBlock Text="Бренд / производитель" Style="{StaticResource ProductsWindow_Label}"/>
<TextBox x:Name="BrandBox" Margin="0,0,0,16"/>
<TextBlock Text="HTTPS-ссылка на фото (необязательно)" Style="{StaticResource ProductsWindow_Label}"/>
<TextBox x:Name="PhotoUrlBox" Margin="0,0,0,16"/>

                        <TextBlock Text="Калорийность, ккал / 100 г"
                                   Style="{StaticResource ProductsWindow_Label}"/>
                        <TextBox x:Name="CaloriesBox"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="Белки, г / 100 г"
                                   Style="{StaticResource ProductsWindow_Label}"/>
                        <TextBox x:Name="ProteinBox"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="Жиры, г / 100 г"
                                   Style="{StaticResource ProductsWindow_Label}"/>
                        <TextBox x:Name="FatBox"
                                 Margin="0,0,0,16"/>

                        <TextBlock Text="Углеводы, г / 100 г"
                                   Style="{StaticResource ProductsWindow_Label}"/>
                        <TextBox x:Name="CarbsBox"
                                 Margin="0,0,0,22"/>

                        <Button x:Name="SaveButton"
                                Content="Добавить продукт"
                                Style="{StaticResource ProductsWindow_Action}"
                                Click="SaveProduct_Click"/>

                        <Button x:Name="DeleteButton"
                                Content="Удалить продукт"
                                Style="{StaticResource ProductsWindow_Action}"
                                Background="#FBECE9"
                                Foreground="#A44F43"
                                Margin="0,10,0,0"
                                IsEnabled="False"
                                Click="DeleteProduct_Click"/>

                        <TextBlock x:Name="StatusText"
                                   FontSize="12"
                                   Margin="0,15,0,0"
                                   Foreground="#55752C"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

