<Window x:Class="DnevnikPitaniya.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Дневник питания"
        Width="1320" Height="820"
        MinWidth="1150" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        FontFamily="Segoe UI"
        FontSize="14"
        Foreground="#202720">

    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#727B75"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Background" Value="#D5F478"/>
            <Setter Property="Foreground" Value="#202720"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderBrush" Value="#6F8F30"/>
                                <Setter TargetName="ButtonSurface"
                                        Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface"
                                        Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B5C0B7"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="17,15"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderBrush" Value="#E0E5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="BorderBrush" Value="#E0E5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource Muted}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Background" Value="#EEF1ED"/>
            <Setter Property="Foreground" Value="#95BD45"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Навигация -->
        <Border Background="#1E2D26">
            <Grid Margin="20,30,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="10,0,0,42">
                    <Border Background="#D5F478"
                            CornerRadius="14"
                            Width="46" Height="46"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,18">
                        <TextBlock Text="&#xE8A5;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="#1E2D26"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Дневник"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="White"/>

                    <TextBlock Text="питания"
                               FontSize="25"
                               Foreground="#D5F478"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="МОЁ ПРОСТРАНСТВО"
                               Foreground="#8D9E92"
                               FontSize="10"
                               Margin="16,0,0,16"/>

                    <Button Content="Дневник"
                            Style="{StaticResource NavButton}"
                            Background="#D5F478"
                            Foreground="#1E2D26"
                            FontWeight="SemiBold"
                            Click="Diary_Click"/>

                    <Button Content="Продукты"
                            Style="{StaticResource NavButton}"
                            Click="Products_Click"/>

                    <Button Content="История веса"
                            Style="{StaticResource NavButton}"
                            Click="Weight_Click"/>

                    <Button Content="Статистика"
                            Style="{StaticResource NavButton}"
                            Click="Statistics_Click"/>

                    <Button Content="Профиль"
                            Style="{StaticResource NavButton}"
                            Click="Profile_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="О программе"
                            Style="{StaticResource NavButton}"
                            Click="About_Click"/>

                    <Border BorderBrush="#3A493F"
                            BorderThickness="0,1,0,0"
                            Margin="10,10,10,0"
                            Padding="0,20,0,0">
                        <TextBlock Text="Маленькие шаги.&#10;Большие перемены."
                                   Foreground="#9DAEA2"
                                   FontSize="12"
                                   LineHeight="21"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Содержимое -->
        <Grid Grid.Column="1" Margin="30,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Твой день в балансе"
                               FontSize="30"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Записывай питание и двигайся к своей цели"
                               Foreground="#727B75"
                               Margin="0,7,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="16"
                        Padding="14,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#EDF4DC"
                                CornerRadius="20"
                                Width="40" Height="40"
                                Margin="0,0,12,0">
                            <TextBlock Text="Я"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Яна"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Контроль питания"
                                       Style="{StaticResource Muted}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

                    <!-- Главные показатели -->
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#D5F478"
                                CornerRadius="20"
                                Padding="24">
                            <StackPanel>
                                <TextBlock Text="Осталось на сегодня"
                                           Foreground="#43552C"/>
                                <TextBlock x:Name="RemainingText"
                                           Text="1900 ккал"
                                           FontSize="34"
                                           FontWeight="SemiBold"
                                           Margin="0,15,0,10"/>
                                <TextBlock Text="До дневной нормы"
                                           FontSize="12"
                                           Foreground="#43552C"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Съедено"
                                           Foreground="#727B75"/>
                                <TextBlock x:Name="EatenText"
                                           Text="0 ккал"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Margin="0,18,0,10"/>
                                <TextBlock Text="За сегодняшний день"
                                           Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4"
                                Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Дневная норма"
                                           Foreground="#727B75"/>
                                <TextBlock Text="1900 ккал"
                                           FontSize="30"
                                           FontWeight="SemiBold"
                                           Margin="0,18,0,10"/>
                                <TextBlock Text="Твой ориентир на день"
                                           Style="{StaticResource Muted}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Макронутриенты -->
                    <Border Style="{StaticResource Card}"
                            Margin="0,0,0,22">
                        <StackPanel>
                            <TextBlock Text="Баланс макронутриентов"
                                       Style="{StaticResource Heading}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="ProteinText"
                                               Text="Белки: 0 / 100 г"/>
                                    <ProgressBar x:Name="ProteinBar"
                                                 Maximum="100"
                                                 Foreground="#95BD45"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="FatText"
                                               Text="Жиры: 0 / 70 г"/>
                                    <ProgressBar x:Name="FatBar"
                                                 Maximum="70"
                                                 Foreground="#DAAF77"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock x:Name="CarbsText"
                                               Text="Углеводы: 0 / 200 г"/>
                                    <ProgressBar x:Name="CarbsBar"
                                                 Maximum="200"
                                                 Foreground="#A59BD4"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="310"/>
                        </Grid.ColumnDefinitions>

                        <!-- Дневник -->
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Приёмы пищи"
                                               FontSize="19"
                                               FontWeight="SemiBold"/>

                                    <Border Grid.Column="1"
                                            Background="#F2F4F0"
                                            CornerRadius="8"
                                            Padding="10,5">
                                        <TextBlock Text="Сегодня"
                                                   FontSize="12"/>
                                    </Border>
                                </Grid>

                                <ListBox x:Name="DiaryList"
                                         MinHeight="300"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.Style>
                                        <Style TargetType="ListBox">
                                            <Style.Triggers>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBox">
                                                                <Border Background="#F7F8F5"
                                                                        CornerRadius="14"
                                                                        Padding="24,55">
                                                                    <StackPanel>
                                                                        <TextBlock Text="&#xE8A5;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="34"
                                                                                   Foreground="#8A9B78"
                                                                                   HorizontalAlignment="Center"
                                                                                   Margin="0,0,0,20"/>
                                                                        <TextBlock Text="Что сегодня на тарелке?"
                                                                                   FontSize="18"
                                                                                   FontWeight="SemiBold"
                                                                                   TextAlignment="Center"/>
                                                                        <TextBlock Text="Добавь первый продукт —&#10;мы посчитаем калории и БЖУ."
                                                                                   Foreground="#727B75"
                                                                                   TextAlignment="Center"
                                                                                   Margin="0,10,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>

                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment"
                                                    Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,16"
                                                    BorderBrush="#EDF0EC"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Margin="0,0,12,0">
                                                        <TextBlock Text="{Binding Meal}"
                                                                   FontSize="12"
                                                                   Foreground="#71874D"
                                                                   Margin="0,0,0,6"/>
                                                        <TextBlock Text="{Binding Product}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Details}"
                                                                   Foreground="#727B75"
                                                                   FontSize="12"
                                                                   Margin="0,6,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding CaloriesText}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <!-- Добавление -->
                        <Border Grid.Column="2"
                                Style="{StaticResource Card}"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Добавить продукт"
                                           Style="{StaticResource Heading}"/>

                                <TextBlock Text="Продукт"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="ProductCombo"
                                          DisplayMemberPath="Name"
                                          Margin="0,0,0,18"/>

                                <TextBlock Text="Приём пищи"
                                           Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="MealCombo"
                                          SelectedIndex="0"
                                          Margin="0,0,0,18">
                                    <ComboBoxItem Content="Завтрак"/>
                                    <ComboBoxItem Content="Обед"/>
                                    <ComboBoxItem Content="Ужин"/>
                                    <ComboBoxItem Content="Перекус"/>
                                </ComboBox>

                                <TextBlock Text="Масса, г"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="MassTextBox"
                                         Margin="0,0,0,22"/>

                                <Button Content="+  Добавить в дневник"
                                        Style="{StaticResource ButtonBase}"
                                        Click="AddProduct_Click"/>

                                <TextBlock x:Name="MessageText"
                                           Foreground="#55752C"
                                           FontSize="12"
                                           Margin="0,12,0,0"
                                           AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>